# Cabeceras de Cloudflare Pages.
# El service worker y el index nunca se guardan en caché: así cada
# actualización llega al iPhone en la siguiente apertura de la app.
/sw.js
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Los archivos de /assets llevan hash en el nombre: pueden guardarse un año.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
